{
  "name": "tlamatini",
  "version": "1.90.0",
  "description": "A sophisticated, locally-run AI developer assistant featuring an advanced Retrieval-Augmented Generation (RAG) system, real-time web interface, visual agentic workflow designer, and multi-model LLM support.",
  "private": true,
  "scripts": {
    "build:canvas-editor": "node scripts/build_canvas_editor.mjs",
    "lint": "eslint Tlamatini/agent/static/agent/js/ Tlamatini/agent/static/agent/interactor/ Tlamatini/agent/interactor/ scripts/ Tests/*.cjs eslint.config.mjs --max-warnings 0 && node scripts/check_js_parse.mjs",
    "lint:fix": "eslint --fix Tlamatini/agent/static/agent/js/ Tlamatini/agent/static/agent/interactor/ Tlamatini/agent/interactor/ scripts/ Tests/*.cjs eslint.config.mjs",
    "lint:python": "python scripts/check_python_quality.py",
    "check-js-parse": "node scripts/check_js_parse.mjs",
    "test": "npm run lint && node scripts/file_drop_router_cases.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angelahack1/Tlamatini.git"
  },
  "keywords": [],
  "author": "Angela López Mendoza (XAIHT)",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/angelahack1/Tlamatini/issues"
  },
  "homepage": "https://github.com/angelahack1/Tlamatini#readme",
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "1.2.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.3.0"
  }
}
