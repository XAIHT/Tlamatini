# ─────────────────────────────────────────────────────────────────────────
#  COPY THIS FILE TO  secrets.yaml  AND FILL IN YOUR OWN VALUES.
#
#  `secrets.yaml` itself is listed in .gitignore and must NEVER be committed —
#  that is the entire reason this project splits credentials out of the device
#  YAML. The device files reference these keys as `!secret wifi_ssid`, so they
#  stay safe to share, publish or paste into a chat.
# ─────────────────────────────────────────────────────────────────────────

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the device's own fallback access point (see common/base.yaml).
# ESPHome requires at least 8 characters.
fallback_password: "CHANGE_ME_8_CHARS"
