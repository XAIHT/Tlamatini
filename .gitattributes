# Preserve generated artifacts byte-for-byte; never apply CRLF conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pptx binary
*.zip binary
*.sqlite3 binary
*.pyc binary
# Evidence, original snapshots, and manifests must retain their recorded bytes.
output/** -text
# Vendored upstream bytes are covered by integrity receipts. A Windows clone
# must not rewrite JS/CSS/license line endings or binary font/decoder data.
Tlamatini/agent/static/agent/vendor/** -text
